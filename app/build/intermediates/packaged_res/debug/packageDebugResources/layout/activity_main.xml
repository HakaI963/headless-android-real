<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_container_lowest"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include layout="@layout/page_displays" />
        <include layout="@layout/page_apps" />
        <include layout="@layout/page_settings" />
    </FrameLayout>

    <!-- M3 navigation bar: 3 destinations, 80dp, surface container, icon + label -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/surface_container_low"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/nav_displays"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/indicator_displays"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_indicator" />

            <ImageView
                android:id="@+id/icon_displays"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/displays"
                android:src="@drawable/ic_displays" />

            <TextView
                android:id="@+id/label_displays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/displays"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_apps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/indicator_apps"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_indicator"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/icon_apps"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/apps"
                android:src="@drawable/ic_apps" />

            <TextView
                android:id="@+id/label_apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/apps"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/indicator_settings"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_indicator"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/icon_settings"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_settings" />

            <TextView
                android:id="@+id/label_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
